# Ignorar ambientes virtuais
**/venv/
**/env/

# Ignorar arquivos Python compilados
*.pyc
*.pyo
*.pyd

# Ignorar arquivos de log
*.log

# Ignorar arquivos de configuração de IDEs
.vscode/
.idea/

# Ignorar arquivos de cache do Python
__pycache__/

# Ignorar arquivos temporários
*.swp

# Bancos SQLite gerados por dataset
backend/db/cache/
backend/experiments/data/

# Dados brutos (grandes demais para o git)
backend/db/taxis/*.parquet
backend/db/us-airports/*.csv
